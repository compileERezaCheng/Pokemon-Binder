{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "collection_v2": {
          ".read": "auth != null && auth.uid === $uid",
          "$copyId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChild('Copy ID') && newData.child('Copy ID').val() === $copyId"
          }
        },
        "collection": {
          ".read": "auth != null && auth.uid === $uid"
        },
        "profile": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "username": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
